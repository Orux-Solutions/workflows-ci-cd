MONGO_ROOT_USERNAME=orux
MONGO_ROOT_PASSWORD=<set-in-your-local-env>
JWT_ACCESS_SECRET=<set-in-your-local-env>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<set-in-your-local-env>
ORUX_DEPLOY_SERVICES=cloudflared mongo business-backend admin-backend client-backend business-frontend admin-frontend client-frontend prometheus grafana node-exporter
ORUX_HEALTH_URL=http://127.0.0.1:3001/api/health/live
ORUX_BUILD_LOCAL=false
GHCR_USERNAME=
GHCR_TOKEN_FILE=/etc/orux/deployer/ghcr-read-token
ORUX_ADMIN_API=https://admin-api.orux.ar/api
ORUX_BUSINESS_API=https://business-api.orux.ar/api
ORUX_CLIENT_API=https://api.orux.ar/api

# Always consume the moving release channel. The autodeployer reads immutable
# release and commit labels from the pulled image for the Admin status screen.
ADMIN_BACKEND_IMAGE_TAG=latest
ADMIN_FRONTEND_IMAGE_TAG=latest
BUSINESS_BACKEND_IMAGE_TAG=latest
BUSINESS_FRONTEND_IMAGE_TAG=latest
CLIENT_BACKEND_IMAGE_TAG=latest
CLIENT_FRONTEND_IMAGE_TAG=latest

# Optional isolated GitHub Actions capacity. The autodeployer only activates
# the profile when every ID and the root-owned private-key file are present.
ORUX_RUNNER_ENABLED=true
GITHUB_RUNNER_ORG=Orux-Solutions
GITHUB_RUNNER_IMAGE=ghcr.io/orux-solutions/orux-github-runner:2.337.0
GITHUB_RUNNER_APP_ID=
GITHUB_RUNNER_APP_INSTALLATION_ID=
GITHUB_RUNNER_GROUP_ID=
GITHUB_RUNNER_APP_PRIVATE_KEY_FILE=/etc/orux/secrets/github-runner-app.pem
GITHUB_RUNNER_NAME_PREFIX=orux
GITHUB_RUNNER_LABELS=orux-ci,orux-buildkit,linux,x64
GITHUB_RUNNER_REPLICAS=5
GITHUB_RUNNER_CPUS=2
GITHUB_RUNNER_MEMORY=6g
GITHUB_RUNNER_WORKSPACE_SIZE=6g
GITHUB_RUNNER_PIDS_LIMIT=512
# Optional: enables the Cloudflare Tunnel in the local autodeployer.
# Create a remotely-managed tunnel in Cloudflare Zero Trust and paste its token here.
# CLOUDFLARE_TUNNEL_TOKEN=
# Alternatively point to a root-owned file containing only the token or the full
# CLOUDFLARE_TUNNEL_TOKEN=... line.
# CLOUDFLARE_TUNNEL_TOKEN_FILE=/secure/path/cloudflare-tunnel-token
