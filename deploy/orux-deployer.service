[Unit]
Description=Orux local Docker Compose autodeployer
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=@ORUX_USER@
Group=@ORUX_GROUP@
WorkingDirectory=@ORUX_DIR@
Environment=HOME=/tmp/orux-deployer-home
RuntimeDirectory=orux-deployer
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/orux-deployer
ExecStartPre=/usr/bin/mkdir -p /tmp/orux-deployer-home
ExecStart=/usr/bin/python3 @ORUX_DIR@/scripts/deployment/local-deployer.py --compose @ORUX_COMPOSE@ --env-file @ORUX_ENV_FILE@ --interval 300
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
